# Copy values into environment variables; .env is not auto-loaded.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production: set DEBUG=false, a random key, actual hosts and HTTPS origins.
# DJANGO_SECRET_KEY=generate-a-long-random-secret
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example
# DJANGO_DB_PATH=/absolute/path/to/db.sqlite3
# REDIS_URL=redis://127.0.0.1:6379/1
